{
  "name": "fundly",
  "version": "1.0.0",
  "private": true,
  "description": "Fundly — household money accountability and expense tracking PWA",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify": "node --experimental-strip-types --no-warnings --import ./scripts/register-verify.mjs scripts/verify-domain.ts",
    "generate:icons": "node scripts/generate-icons.mjs",
    "check": "npm run typecheck && npm run verify && npm run build"
  },
  "keywords": [
    "fundly",
    "pwa",
    "nextjs",
    "household",
    "expenses"
  ],
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
